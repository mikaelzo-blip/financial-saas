ENVIRONMENT=development
DEBUG=true
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/financial_saas
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/financial_saas
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
SECRET_KEY=replace-with-a-unique-random-secret-of-at-least-32-characters
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
STORAGE_DIR=C:/financial-saas/storage
DOCUMENT_MAX_SIZE_BYTES=26214400
DOCUMENT_CONFIDENCE_THRESHOLD=0.85
DOCUMENT_EXTRACTION_PROVIDER=local
# RC1 default. Set to baileys only after pairing with `hermes whatsapp` and
# configuring WHATSAPP_ADAPTER_TOKEN plus WHATSAPP_TENANT_TOKENS locally.
# The Windows one-click startup then starts and verifies the local bridge.
WHATSAPP_PROVIDER=mock
WHATSAPP_BAILEYS_BRIDGE_URL=http://127.0.0.1:3000
WHATSAPP_SAAS_URL=http://127.0.0.1:8000
AI_INSIGHT_PROVIDER=mock
