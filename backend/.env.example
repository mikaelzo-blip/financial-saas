# Application
PROJECT_NAME="Financial SaaS Backend"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Database
# PostgreSQL connection URL (AsyncPG driver)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/financial_saas"
# Synchronous DB URL for Alembic migrations if needed
SYNC_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/financial_saas"

# Security
SECRET_KEY="change-this-insecure-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage
STORAGE_DIR="backend/storage"
